\songheader{Tahmila Suznak}{Sami Shawwa}{Suznak Do}

###
\time 2/4
\key do  #`((2 . ,SEMI-FLAT)
            (5 . ,FLAT))

\repeat volta 2{
lab'16 sol lab si lab8 sol
sol16 fa sol lab sol8 fa
fa16 misb fa sol fa8 misb
misb16 re misb fa misb8 re
re16 do re misb re8 do
do sol do re
misb fa misb re
misb fa misb re
misb fa sol16 lab sol fa misb fa misb re do8 sol
do sol' fa sol
la sol16 fa misb re misb fa
sol8 fa16 misb re do re misb
fa8 misb16 re do8 sol'
sol8 fa16 sol fa8 misb
re2^"Fine"
do4 misb8 fa misb re misb fa misb re misb fa
sol16 lab sol fa misb fa misb re
}
\alternative{
    {do2}
    {
        \repeat volta 2{
        do8^\markup \italic "Improvisación. Repetir n veces" r4. r2
        r8 misb misb misb
        fa8. misb16 re do misb fa \bar ":|."
        }
    }
}
do8 lab'16 lab lab8 lab^"D.C al Fine"

###